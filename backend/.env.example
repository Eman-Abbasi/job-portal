# Database Configuration
# Update this with your PostgreSQL connection string
# Format: postgresql://USERNAME:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://jobportal:jobportal123@localhost:5432/jobportal?schema=public"

# JWT Configuration
# Generate a strong random secret for production (e.g., use openssl rand -base64 32)
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"

# Server Configuration
PORT=5000

# Frontend URL (for CORS)
# Update this if your frontend runs on a different port or domain
FRONTEND_URL="http://localhost:3000"
